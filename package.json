{
	"name": "statusbar-quotes",
	"displayName": "StatusBar Quotes",
	"description": "Quiet motivation in your VS Code status bar. Add your own custom quotes, principles, and categories.",
	"icon": "assets/speech-balloon-ms.png",
	"version": "26.4.20",
	"publisher": "kim-sardine",
	"engines": {
		"vscode": "^1.73.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"custom quotes",
		"status bar quote",
		"developer motivation",
		"personal quotes",
		"coding principles",
		"focus",
		"developer productivity",
		"quotes"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/kim-sardine/statusbar-quotes"
	},
	"bugs": {
		"url": "https://github.com/kim-sardine/statusbar-quotes/issues",
		"email": "kim-sardine@gmail.com"
	},
	"license": "SEE LICENSE IN LICENSE.md",
	"galleryBanner": {
		"color": "#C80000",
		"theme": "dark"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "StatusBar Quotes",
			"properties": {
				"statusbar-quotes.category": {
					"type": "string",
					"default": "All",
					"enum": [
						"All",
						"Wise Saying",
						"Programming",
						"Startup",
						"How to Win Friends and Influence People (Dale Carnegie)",
						"Choose Custom Category..."
					],
					"enumDescriptions": [
						"",
						"Mindfulness",
						"May the Force be with you..",
						"Inspirational quotes for startups",
						"Great opportunity to improve yourself social relations",
						"Open the category picker so you can choose a custom category."
					],
					"markdownDescription": "Choose a built-in quote category. Select `Choose Custom Category...` to open the category picker and choose one of your custom categories."
				},
				"statusbar-quotes.language": {
					"type": "string",
					"default": "English",
					"enum": [
						"English",
						"Korean"
					]
				},
				"statusbar-quotes.display-seconds": {
					"type": "integer",
					"minimum": 0,
					"maximum": 86400,
					"default": 15,
					"markdownDescription": "How many seconds do you want the quote to be changed?\n\n range : 0 *(do not change quote)* ~ 86400 *(1 hour)*"
				},
				"statusbar-quotes.display-shuffle-button": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Display shuffle button to the left of the quote."
				},
				"statusbar-quotes.custom-quotes": {
					"type": "object",
					"default": {
						"version": 2,
						"categories": {}
					},
					"markdownDescription": "Advanced: manage your custom quotes as JSON. Use category names as keys and string arrays as quotes, for example `{ \"version\": 2, \"categories\": { \"Principles\": [\"Ship small, verify honestly.\"] } }`. You can also use the Command Palette commands to manage this setting."
				}
			}
		},
		"commands": [
			{
				"command": "statusbar-quotes.change-language",
				"title": "Change language",
				"category": "StatusBar Quote"
			},
			{
				"command": "statusbar-quotes.change-category",
				"title": "Change category",
				"category": "StatusBar Quote"
			},
			{
				"command": "statusbar-quotes.change-display-seconds",
				"title": "Change display seconds",
				"category": "StatusBar Quote"
			},
			{
				"command": "statusbar-quotes.add-custom-category",
				"title": "Add Custom Category",
				"category": "StatusBar Quote"
			},
			{
				"command": "statusbar-quotes.manage-custom-categories",
				"title": "Manage Custom Categories",
				"category": "StatusBar Quote"
			},
			{
				"command": "statusbar-quotes.add-custom-quote",
				"title": "Add Custom Quote",
				"category": "StatusBar Quote"
			},
			{
				"command": "statusbar-quotes.manage-custom-quotes",
				"title": "Manage Custom Quotes",
				"category": "StatusBar Quote"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "yarn run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "yarn run compile && yarn run lint",
		"lint": "eslint src",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.0",
		"@types/vscode": "1.73.0",
		"@typescript-eslint/eslint-plugin": "^8.58.2",
		"@typescript-eslint/parser": "^8.58.2",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^10.2.1",
		"glob": "^13.0.6",
		"mocha": "^11.7.5",
		"typescript": "^6.0.3"
	}
}
